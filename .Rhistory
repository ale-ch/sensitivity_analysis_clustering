fpc::cluster.stats(DMat, clustering[[cl]]))
if (!is.null(stats)) indexes[cl, ] <- c(stats$avg.silwidth, stats$pearsongamma,
stats$within.cluster.ss, stats$ch, stats$dunn)
}
write.csv(data.frame(K = clust, indexes), file.path(output_dir, "Indici_K2_K15.csv"), row.names = FALSE)
Indici_geodetici <- dplyr::bind_rows(lapply(clust, function(kk) {
g_geo <- cutree(treeD0D1_alpha1, kk)
ss_geo <- fpc::cluster.stats(D1_std, g_geo)
data.frame(K = kk, ASW = ss_geo$avg.silwidth, PG = ss_geo$pearsongamma,
WSS = ss_geo$within.cluster.ss, Dunn = ss_geo$dunn,
Q1 = 1 - ClustGeo::withindiss(D1_std, g_geo, wt = wt) / T1_std)
}))
write.csv(Indici_geodetici, file.path(output_dir, "Indici_geodetici_K2_K15.csv"), row.names = FALSE)
posizioni_gomito <- lapply(seq_len(ncol(indexes)), function(j) which.max(abs(diff(indexes[, j]))))
gomiti_originali <- dplyr::bind_rows(lapply(seq_len(ncol(indexes)), function(j) {
pos <- posizioni_gomito[[j]]
data.frame(indice = colnames(indexes)[j],
posizione_diff = if (length(pos)) pos else NA_integer_,
K_iniziale = if (length(pos)) clust[pos] else NA_integer_,
K_finale = if (length(pos)) clust[pos + 1L] else NA_integer_)
}))
write.csv(gomiti_originali, file.path(output_dir, "Gomiti_indici_originali.csv"), row.names = FALSE)
tenta_output_originale("Indici_K2_K15.png", salva_base_originale("Indici_K2_K15.png", function() {
par(mfrow = c(2, 3), mar = c(4, 4, 3, 1))
for (j in seq_len(ncol(indexes))) plot(clust, indexes[, j], type = "b", pch = 16,
col = "#3475AB", xlab = "K", ylab = colnames(indexes)[j], main = colnames(indexes)[j])
}))
disegna_dendrogramma <- function(albero, alpha_testo, numero_gruppi = K) {
par(mar = c(3, 4, 4, 1))
plot(albero, hang = -1, labels = FALSE, xlab = "", ylab = "Aggregation height",
main = paste("Ward -", params$area), sub = paste("K =", numero_gruppi, ";", alpha_testo))
gruppi <- cutree(albero, numero_gruppi)
ordine <- unique(gruppi[albero$order])
rect.hclust(albero, k = numero_gruppi, border = unname(palette_multik[as.character(ordine)]))
legend("topright", legend = paste0("C", seq_len(numero_gruppi)),
fill = unname(palette_multik[as.character(seq_len(numero_gruppi))]), border = NA, bty = "n", cex = 0.7)
}
