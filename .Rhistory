"Profili_gruppi_interattivi.html"))
Catalogo_selezione$presente <- file.exists(file.path(output_dir, Catalogo_selezione$file))
Catalogo_selezione$bytes <- unname(file.info(file.path(output_dir, Catalogo_selezione$file))$size)
stopifnot(all(Catalogo_selezione$presente), all(Catalogo_selezione$bytes > 0))
write.csv(Catalogo_selezione, file.path(output_dir, "Indice_output_selezione.csv"), row.names = FALSE)
oggetti <- union(oggetti, c("Catalogo_output_originali", "Errori_output_originali", "Catalogo_selezione"))
save(list = oggetti, envir = knitr::knit_global(),
file = file.path(output_dir, "Risultati_selezione_K_alpha.RData"), compress = "gzip")
writeLines(capture.output(sessionInfo()), file.path(output_dir, "sessionInfo.txt"))
writeLines(capture.output(sf::sf_extSoftVersion()),
file.path(output_dir, "Versioni_GEOS_GDAL_PROJ.txt"))
completa_originali <- all(Catalogo_output_originali$stato == "generato") && nrow(Errori_output_originali) == 0L
stato_finale <- if (completa_originali) "COMPLETATA IN R" else "COMPLETATA CON ERRORI NEGLI OUTPUT ORIGINALI"
file_attestato <- if (completa_originali) "ESECUZIONE_COMPLETATA_R.txt" else "ESECUZIONE_CON_ERRORI_OUTPUT_ORIGINALI.txt"
writeLines(c(stato_finale, paste("Area:", params$area),
paste("Milano nella stima:", includi_milano), paste("K0:", K0), paste("K finale:", K),
paste("Alpha scelto:", alpha_ottimo), paste("Fine:", Sys.time())),
file.path(output_dir, file_attestato))
writeLines(stato_finale, file.path(output_dir, "STATO.txt"))
cat("Risultati salvati in:", output_dir)
knitr::kable(Catalogo_selezione, caption = "Output della selezione di K e alpha", row.names = FALSE)
knitr::kable(Catalogo_output_originali[c("file", "origine", "stato")], row.names = FALSE)
if (nrow(Errori_output_originali)) {
print(knitr::kable(Errori_output_originali, caption = "Errori effettivamente restituiti da R", row.names = FALSE))
}
sessionInfo()
