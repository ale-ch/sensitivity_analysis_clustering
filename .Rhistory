inerzie_normalizzate = c(T0 = T0_std, T1 = T1_std),
variabili_D0 = colnames(Xmat_nogeo), p_variabili = length(variabili_clustering),
gestione_duplicati = "filter(!duplicated(LAU_Code)) dopo le somme e prima di CData",
K_figura_profili = K_confronto, scale_profili = names(scale_profili),
alpha_ARI_a_K_fisso = griglia_alpha_ARI,
asimmetria = "Fisher-Pearson corretta G1 (type 2)",
curtosi = "eccesso corretto G2 (type 2), riferimento normale 0",
R = R.version.string, ClustGeo = as.character(packageVersion("ClustGeo")),
mclust = as.character(packageVersion("mclust")),
geosphere = as.character(packageVersion("geosphere")),
DT = as.character(packageVersion("DT")), htmlwidgets = as.character(packageVersion("htmlwidgets")))
write.csv(partizioni, file.path(output_dir, "Partizioni_native.csv"), row.names = FALSE)
write.csv(partizioni_colori, file.path(output_dir, "Partizioni_colori_stima.csv"), row.names = FALSE)
write.csv(sf::st_drop_geometry(Data_clusters),
file.path(output_dir, "Presentazione_e_dati_comunali.csv"), row.names = FALSE)
write.csv(abbinamenti, file.path(output_dir, "Abbinamento_colori.csv"), row.names = FALSE)
write.csv(cr8_out, file.path(output_dir, "Curve_alpha_K8.csv"), row.names = FALSE)
write.csv(indici, file.path(output_dir, "Indici_quattro_alpha.csv"), row.names = FALSE)
write.csv(casi, file.path(output_dir, "Casi_alpha.csv"), row.names = FALSE)
write.csv(data.frame(caso = rownames(ARI_matrice), ARI_matrice, check.names = FALSE),
file.path(output_dir, "ARI_matrice.csv"), row.names = FALSE)
write.csv(ARI_coppie, file.path(output_dir, "ARI_confronti_coppie.csv"), row.names = FALSE)
tabella_palette <- data.frame(cluster = names(palette_cluster),
etichetta = legenda_cluster, colore_hex = unname(palette_cluster))
write.csv(tabella_palette, file.path(output_dir, "Palette_cluster.csv"), row.names = FALSE)
write.csv(audit_dimensioni, file.path(output_dir, "Audit_dimensioni.csv"), row.names = FALSE)
write.csv(provenienza, file.path(output_dir, "Input_MD5.csv"), row.names = FALSE)
write.csv(dimensioni_cluster, file.path(output_dir, "Dimensioni_cluster.csv"), row.names = FALSE)
saveRDS(configurazione, file.path(output_dir, "Configurazione.rds"))
# Il GeoPackage usa gli ID delle osservazioni; il FID originale puo essere
# ripetuto per effetto del join. La tabella completa resta in CSV e nell'RData.
campi_mappa <- c("id_osservazione", "LAU_Code", "NUTS2_Name", casi$caso,
paste0(casi$caso, "_originale"))
geometrie_output <- Data_clusters %>% dplyr::select(all_of(campi_mappa))
sf::st_write(geometrie_output, file.path(output_dir, "Mappe_quattro_alpha.gpkg"),
layer = "cluster", delete_layer = TRUE, quiet = TRUE)
oggetti <- c("CData", "Xmat_nogeo", "Xmat_geo", "n", "wt", "K0", "K", "kopt", "K_candidati",
"variabili_clustering", "Audit_filtro_duplicati", "Comuni_duplicati_prima_filtro",
"Righe_rimosse_duplicati", "Controllo_duplicati_valori",
"K0_automatico", "K_finale_automatico", "diagnostica_K0", "diagnostica_K_finale",
"Manifesto_variabili", "Audit_unita_statistiche", "Comuni_duplicati_stima",
"T0_std", "T1_std", "Indici_geodetici", "descrizione_criterio_alpha",
"selezione_K_alpha", "riepilogo_selezione", "cr_K0", "curva_alpha_K0", "tree_alpha_scelto",
"cr8", "cr8_out", "range_alpha", "casi", "alpha_ottimo", "alpha_automatico", "alpha_fisso",
"tree_D0", "treeD0D1", "treeD0D1_alpha0", "treeD0D1_alpha010", "treeD0D1_alpha1",
"alberi", "partizioni", "partizioni_colori", "Data_clusters", "DPCM_red2",
"indici", "ARI_matrice", "ARI_coppie", "ARI_long",
"palette_cluster", "palette_multik", "tabella_palette",
"Profili_K_finale_Geo", "Profili_K_finale_NoGeo",
"K_confronto", "Casi_multik", "Partizioni_multik_confronto", "Colori_multik_confronto",
"Abbinamento_colori_multik", "Dimensioni_multik", "ARI_multik", "Profili_gruppi_multik",
"ARI_stabilita_K", "ARI_stabilita_K_alpha0", "ARI_stabilita_K_alphaottimo",
"ARI_stabilita_K_long", "ARI_stabilita_K_coppie",
"griglia_alpha_ARI", "Griglia_alpha_ARI", "Partizioni_alpha_ARI",
"ARI_stabilita_alpha", "ARI_stabilita_alpha_long", "ARI_stabilita_alpha_coppie",
"ARI_stabilita_alpha_tabella",
"dimensioni_cluster", "configurazione", "provenienza")
if (isTRUE(params$salva_distanze)) {
oggetti <- c(oggetti, "DMat", "DMat_geo", "D0", "D1", "D0_std", "D1_std")
}
# Oggetti e diagnostiche che l'allegato conservava nel workspace.
nomi_originali <- c("Data_plot", "q", "corr", "corrmat", "p_corr", "f1", "f2",
"ind_sil", "ind_ch", "ind_dunn", "ind_mc", "ind_c", "clustering", "clust", "indexes",
"stats", "Cl_D0", paste0("cr", 1:10), paste0("cr", 1:10, "_Q0"), "cr_out", "diff_cr_out",
"Pa", "Pb", "p1", "p2", "colp", "Regione", "Data_clusters_originale", "Tabella_Geo",
"Tabella_NoGeo", "Profili_originali", "Dizionario_etichette_originali", "Partizioni_multik",
"NbClust_economico", "NbClust_indici", "NbClust_raccomandazioni", "gomiti_originali",
"curve_per_K", "kmpp", "NbClust_mod", "Estim_alpha", "test")
oggetti <- union(oggetti, intersect(nomi_originali, ls(envir = knitr::knit_global())))
# Cache esportata per completezza; l'analisi non la carica e non sovrascrive D0/D1.
nomi_cache <- c(paste0("cr", 1:10), "curve_per_K", "configurazione")
if (isTRUE(params$salva_distanze)) nomi_cache <- c(nomi_cache, "D0", "D1", "D0_std", "D1_std")
tenta_output_originale("Res_Nat_AlphaGivenK.RData",
save(list = nomi_cache, envir = knitr::knit_global(),
file = file.path(output_dir, "Res_Nat_AlphaGivenK.RData"), compress = "gzip"))
# save.image() salverebbe l'ambiente globale, che puo differire da quello del knit.
# Qui si salva lo snapshot dell'ambiente nel quale l'analisi e stata eseguita.
if (exists(".Random.seed", envir = .GlobalEnv, inherits = FALSE)) {
assign(".Random.seed", get(".Random.seed", envir = .GlobalEnv), envir = knitr::knit_global())
}
oggetti_workspace <- ls(envir = knitr::knit_global(), all.names = TRUE)
if (!isTRUE(params$salva_distanze)) {
oggetti_workspace <- setdiff(oggetti_workspace, c("DMat", "DMat_geo", "D0", "D1", "D0_std", "D1_std"))
}
tenta_output_originale("Res_national_11082024.RData",
save(list = oggetti_workspace, envir = knitr::knit_global(),
file = file.path(output_dir, "Res_national_11082024.RData"), compress = "gzip"))
# Inventario: i dodici PNG e il workspace salvati esplicitamente nell'allegato,
# piu le diagnostiche/tabelle che prima erano soltanto mostrate a video.
Catalogo_output_originali <- data.frame(
file = c("DoubleNormVariablesD0_Lombardy.png", "CorrMat.png", "D0_mat.png", "D1_mat.png",
"AvgDist_D0.png", "ChoiceAlpha.png", "Dendrogram.png", "ClusterGeoInform.png",
"ClusterNonGeoInform.png", "NormVariablesD0.png", "GeoInform_k8.png", "NonGeoInform_k8.png",
