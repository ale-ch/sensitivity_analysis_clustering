Catalogo_output_originali$origine <- c(
rep("File salvato esplicitamente nell'allegato", 13),
"Dendrogramma non spaziale mostrato a video", "Matrice indexes K=2...15", "Grafici della matrice indexes",
"which.max(abs(diff(indexes)))", "Oggetti ind_sil/ind_ch/ind_dunn/ind_mc/ind_c",
"All.index economici", "Best.nc economici", "cr2 Q1norm-Q0norm", "Grafico cr2 Q1norm-Q0norm",
"cr_out", "diff(cr_out)", "Cl_D0 geografico", "Cl_D0 All.index", "Quattro grafici di Cl_D0",
"Cl_D0 Best.nc", "D0_P3...P15 e D0D1_P3...P15", "View Geo", "View No geo", "Regione",
"Salvataggio delle curve, commentato nell'allegato", "Oggetto corr", "Oggetto corrmat",
"AvgDist_D0/AvgDist_D1", "Mappa aggiuntiva della distanza D1",
"Taglio K=3 del dendrogramma nell'allegato", rep("cr1...cr10", 20))
percorsi_catalogo <- file.path(output_dir, Catalogo_output_originali$file)
Catalogo_output_originali$presente <- file.exists(percorsi_catalogo)
Catalogo_output_originali$bytes <- unname(file.info(percorsi_catalogo)$size)
Errori_output_originali <- if (length(errori_output_originali)) {
dplyr::bind_rows(errori_output_originali)
} else data.frame(operazione = character(), messaggio = character())
Catalogo_output_originali$stato <- ifelse(Catalogo_output_originali$presente &
!is.na(Catalogo_output_originali$bytes) & Catalogo_output_originali$bytes > 0,
"generato", "non generato")
Catalogo_output_originali$stato[Catalogo_output_originali$file %in% Errori_output_originali$operazione] <- "errore"
write.csv(Catalogo_output_originali, file.path(output_dir, "Indice_output_originali.csv"), row.names = FALSE)
write.csv(Errori_output_originali, file.path(output_dir, "Errori_output_originali.csv"), row.names = FALSE)
Catalogo_selezione <- data.frame(file = c(
"Diagnostica_K0.csv",
"Curve_alpha_selezione_K0.csv",
"Diagnostica_K_finale.csv",
"Passaggi_selezione.csv",
"Selezione_K_alpha.csv",
